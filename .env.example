# ==============================================================================
# Flux — Smart Telemetry System Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local configuration.
# 2. Never commit your actual '.env' or secret keys to version control.
# 3. Client applications (Android / Firmware) must NEVER include privileged secrets
#    such as SUPABASE_SERVICE_ROLE_KEY or ONESIGNAL_REST_API_KEY.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous Key (safe for Android client use with RLS enabled)
SUPABASE_ANON_KEY=your-supabase-public-anon-key-placeholder

# Supabase Service Role Key (SERVER-SIDE ONLY - Vault / Edge Function secrets)
# WARNING: NEVER expose this key in Android BuildConfig, APKs, or firmware!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 2. OneSignal Notification Configuration
# ------------------------------------------------------------------------------
# OneSignal Application ID (safe for Android client push SDK initialization)
ONESIGNAL_APP_ID=your-onesignal-app-id-placeholder

# OneSignal REST API Key (SERVER-SIDE ONLY - Supabase Edge Function secrets)
# Used exclusively by 'flux-alert-evaluator' Edge Function to dispatch push alerts.
# WARNING: NEVER embed this in Android code or firmware!
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key-placeholder

# ------------------------------------------------------------------------------
# 3. Telemetry & Cloud Rate Limits
# ------------------------------------------------------------------------------
# Frequency (in seconds) at which telemetry is uploaded to Supabase (Default: 5s)
FLUX_CLOUD_UPLOAD_INTERVAL_SEC=5

# Maximum records buffered in offline queue before oldest are pruned (Default: 500)
FLUX_OFFLINE_QUEUE_MAX_CAPACITY=500

# Telemetry data retention threshold in days before historical prune (Default: 30 days)
FLUX_DATA_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 4. Default Temperature Safety Thresholds (Celsius)
# ------------------------------------------------------------------------------
# High temperature safety breach threshold in °C (Default: 28.0°C)
FLUX_DEFAULT_HIGH_TEMP_THRESHOLD_C=28.0

# Low temperature safety breach threshold in °C (Default: 18.0°C)
FLUX_DEFAULT_LOW_TEMP_THRESHOLD_C=18.0

# Anti-flap hysteresis cooldown window in minutes between repeated alerts (Default: 15m)
FLUX_ALERT_HYSTERESIS_MINUTES=15
